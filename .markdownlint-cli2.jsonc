{
  // Gate documental consumido por .github/workflows/docs-validate.yml.
  // Estado: draft. Fuente de reglas: docs/09-quality/documentation-validation.md.
  // Se relajan solo reglas de estilo que no afectan a la corrección documental:
  //   MD012 blancos múltiples (corpus heredado)
  //   MD013 longitud de línea (tablas y URLs de evidencia)
  //   MD024 encabezados repetidos, salvo entre hermanos
  //   MD031 blancos alrededor de fences (pendiente: normalizar operator-corpus.md)
  //   MD033 HTML embebido (tablas comparativas y detalles)
  //   MD060 estilo de columna de tabla (marcado por versiones recientes)
  "config": {
    "MD012": false,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD031": false,
    "MD033": false,
    "MD060": false
  }
}
