{
  "name": "@archmaker/web",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build:wasm": "bash ../../tools/build-wasm.sh",
    "build": "pnpm build:wasm && tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test-a11y": "python3 ./a11y-check.py",
    "test-a11y:axe": "playwright test a11y-playwright.test.ts",
    "test-a11y:visual": "playwright test visual-regression.test.ts",
    "test-a11y:flow": "playwright test mock-flow.playwright.test.ts responsive-layout.playwright.test.ts forge-helpers.playwright.test.ts export-delivery.playwright.test.ts consented-import.playwright.test.ts draft-persistence.playwright.test.ts product-acceptance.playwright.test.ts",
    "test-a11y:all": "pnpm test-a11y && pnpm test-a11y:axe && pnpm test-a11y:visual && pnpm test-a11y:flow",
    "test-e2e:fidelity": "playwright test mock-flow.playwright.test.ts --grep \"F3 ejercicio|inventario\"",
    "test-f7:unit": "playwright test forge-helpers.playwright.test.ts export-delivery.playwright.test.ts consented-import.playwright.test.ts",
    "test-f7:e2e-wasm": "playwright test wasm-flow.playwright.test.ts --workers=1 --retries=0",
    "test-f7:offline-web": "playwright test wasm-offline.playwright.test.ts --retries=0",
    "test-f7:product-p95-sample": "node scripts/product-p95-sample.mjs",
    "test-f7:e2e-wasm-x3": "bash scripts/run-e2e-x3.sh",
    "test-p5:acceptance": "playwright test product-acceptance.playwright.test.ts draft-persistence.playwright.test.ts forge-helpers.playwright.test.ts --workers=1 --retries=0"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.5"
  }
}
