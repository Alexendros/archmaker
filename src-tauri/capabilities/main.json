{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Ventana main: CorePort + guardado nativo acotado (save_export_bytes). Sin shell ni FS global.",
  "windows": ["main"],
  "permissions": [
    "allow-create-draft",
    "allow-load-catalog",
    "allow-save-draft",
    "allow-open-draft",
    "allow-resolve-draft",
    "allow-validate-draft",
    "allow-build-manifest",
    "allow-export-artifact",
    "allow-import-draft",
    "allow-save-export-bytes",
    "allow-inspect-host-hardware",
    "allow-inspect-storage-devices",
    "allow-refresh-storage-snapshot",
    "allow-propose-storage-plan",
    "allow-validate-storage-plan",
    "allow-import-storage-snapshot",
    "allow-constitute-image"
  ]
}
