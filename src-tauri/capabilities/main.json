{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Ventana main: solo comandos CorePort de producto. Deny-by-default para el resto.",
  "windows": ["main"],
  "permissions": [
    "allow-create-draft",
    "allow-load-catalog",
    "allow-save-draft",
    "allow-open-draft",
    "allow-resolve-draft",
    "allow-validate-draft",
    "allow-build-manifest",
    "allow-export-artifact",
    "allow-import-draft"
  ]
}
