{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArchMaker",
  "version": "0.1.0",
  "identifier": "dev.archmaker.app",
  "build": {
    "frontendDist": "../apps/web/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ArchMaker",
        "width": 1024,
        "height": 768
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["../packages/tokens/tokens.css"],
    "icon": [
      "icons/icon.png",
      "icons/icon-32.png",
      "icons/icon-128.png",
      "icons/icon-256.png",
      "icons/icon-512.png"
    ]
  },
  "plugins": {
    "updater": {
      "active": false
    }
  }
}
