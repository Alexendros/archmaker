{
  "main-capability": {
    "identifier": "main-capability",
    "description": "Ventana main: solo comandos CorePort de producto. Deny-by-default para el resto.",
    "local": true,
    "windows": ["main"],
    "permissions": [
      "allow-create-draft",
      "allow-load-catalog",
      "allow-save-draft",
      "allow-open-draft",
      "allow-resolve-draft",
      "allow-validate-draft",
      "allow-build-manifest",
      "allow-export-artifact",
      "allow-import-draft"
    ]
  },
  "restricted-capability": {
    "identifier": "restricted-capability",
    "description": "Ventana de prueba ACL: sin permisos de comandos propios.",
    "local": true,
    "windows": ["restricted"],
    "permissions": []
  }
}
