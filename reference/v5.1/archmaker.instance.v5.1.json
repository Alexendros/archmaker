              {
                "id": "btop",
                "name": "btop",
                "pkg": "btop"
              }
            ]
          }
        ]
      }
    ]
  },
  "validation": {
    "engine": "live",
    "blocking": true,
    "rules": [
      {
        "id": "single-compositor",
        "type": "error",
        "blocking": true,
        "when": {
          "count_gt": [
            "compositor",
            1
          ]
        },
        "action": "block",
        "note": "Solo 1 compositor permitido - nueva lógica v5.1"
      },
      {
        "id": "gdm-gnome",
        "type": "info",
        "when": {
          "eq": [
            "compositor",
            "gnome"
          ]
        },
        "action": "change",
        "target": "dm",
        "allowed": [
          "gdm"
        ],
        "note": "GNOME -> GDM autoseleccionado y bloqueado"
      },
      {
        "id": "nvidia-sway",
        "type": "error",
        "when": {
          "all": [
            {
              "eq": [
                "gpu",
                "nvidia"
              ]
            },
            {
              "eq": [
                "compositor",
                "sway"
              ]
            }
          ]
        },
        "action": "change"
      }
    ]
  },
  "build": {
    "output_dir": "./out",
    "iso_name_template": "archmaker-{version}-{arch}.iso",
    "compression": "zstd",
    "compression_level": 15,
    "checksums": [
      "sha256"
    ],
    "pipeline": [
      "validate",
      "resolve",
      "derive_palette",
      "pacstrap",
      "assemble",
      "checksum"
    ]
  },
  "presets": [
    {
      "id": "minimal",
      "name": "Mínimo",
      "selections": {
        "kernel": "linux",
        "filesystem": "btrfs-progs",
        "boot": "systemd-boot",
        "compositor": "hyprland",
        "terminal": "ghostty"
      }
    },
    {
      "id": "desktop",
      "name": "Escritorio",
      "parent": "minimal",
      "selections": {
        "compositor": "gnome",
        "dm": "gdm",
        "browser": "firefox",
        "apps": [
          "steam",
          "vlc"
        ]
      }
    },
    {
      "id": "dev",
      "name": "Desarrollo",
      "parent": "desktop",
      "selections": {
        "dev-pack": [
          "docker",
          "rustup"
        ],
        "terminal": "ghostty",
        "apps": [
          "obsidian"
        ]
      }
    }
  ]
}