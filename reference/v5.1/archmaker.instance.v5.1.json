              }
            ]
          },
          {
            "id": "dev-pack",
            "name": "Desarrollo",
            "essential": [
              {
                "id": "git",
                "name": "Git",
                "fixed": true,
                "pkg": "git",
                "reason": "Control versiones base"
              },
              {
                "id": "python",
                "name": "Python",
                "fixed": true,
                "pkg": "python",
