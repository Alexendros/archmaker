{
  "archmaker": {
    "name": "ArchMaker",
    "version": "5.1.0",
    "date": "2026-10-05",
    "arch": [
      "x86_64"
    ],
    "deploy": "local",
    "arch_info": {
      "x86_64": {
        "desc": "Intel/AMD 64-bit",
        "compat": "Total: AUR completo, Steam nativo, drivers Nvidia/AMD maduros",
        "recommended_for": "PC/laptop estándar, gaming, workstation",
        "pacstrap": "pacstrap /mnt base linux btrfs-progs base-devel"
      },
      "aarch64": {
        "desc": "ARM 64-bit",
        "compat": "Parcial: algunos AUR no compilados, Steam requiere box64, drivers en evolución",
        "recommended_for": "Apple Silicon, Raspberry Pi 5, Snapdragon X Elite, eficiencia energética",
        "pacstrap": "pacstrap /mnt base linux-aarch64 btrfs-progs base-devel"
      }
    },
    "iso": {
      "name": "archmaker-forge-v5.1"
    }
  },
  "palette": {
    "canonical": "oklch",
    "tokens": [
      {
        "token": "--rh-red",
        "hex": "#ee0000",
        "oklch": "oklch(0.62 0.24 29)",
        "usage": "primary"
      },
      {
        "token": "--rh-blue",
        "hex": "#0066cc",
        "oklch": "oklch(0.55 0.18 250)",
        "usage": "focus"
      },
      {
        "token": "--rh-black",
        "hex": "#151515",
        "oklch": "oklch(0.20 0 0)",
        "usage": "text"
      }
    ]
  },
  "configurator": {
    "type": "multi",
    "steps": [
      {
        "id": "base",
        "name": "Sistema Base",
        "icon": "🧰",
        "mode": "grouped",
        "sections": [
          {
            "id": "kernel",
            "name": "Kernel",
            "single": true,
            "options": [
              {
                "id": "linux",
                "name": "Linux",
                "pkg": "linux",
                "size": 180,
                "tags": [
                  "Recomendado"
                ],
                "description": "7.1.2 estable"
              },
              {
                "id": "linux-zen",
                "name": "Linux Zen",
                "pkg": "linux-zen",
                "size": 185,
                "tags": [
                  "Gaming"
                ],
                "description": "7.1-zen baja latencia"
              },
              {
                "id": "linux-hardened",
                "name": "Linux Hardened",
                "pkg": "linux-hardened",
                "size": 182,
                "tags": [
                  "Seguridad"
                ],
                "description": "Endurecido, nuevo en v5.1, reemplaza LTS"
              }
            ]
          },
          {
            "id": "filesystem",
            "name": "Sistema de Archivos",
            "options": [
              {
                "id": "btrfs-progs",
                "name": "Btrfs",
                "pkg": "btrfs-progs",
                "fixed": true,
                "tags": [
                  "Recomendado"
                ],
                "description": "Snapshots + zstd, recomendado"
              },
              {
                "id": "e2fsprogs",
                "name": "Ext4",
                "pkg": "e2fsprogs",
                "tags": [
                  "Clásico"
                ],
                "description": "Estable clásico"
              }
            ]
          },
          {
            "id": "base-devel",
            "name": "Base Devel",
            "options": [
              {
                "id": "base-devel",
                "name": "base-devel",
                "pkg": "base-devel",
                "fixed": true,
                "tags": [
                  "Esencial"
                ],
                "description": "gcc, make, patch - esencial AUR, sustituye concepto antiguo base-devel como pack fijo"
              }
            ]
          },
          {
            "id": "boot",
            "name": "Bootloader",
            "single": true,
            "options": [
              {
                "id": "systemd-boot",
                "name": "systemd-boot",
                "pkg": "systemd-boot",
                "tags": [
                  "Recomendado"
                ],
                "description": "Ligero UEFI 2025+"
              },
              {
                "id": "grub",
                "name": "GRUB",
                "pkg": "grub",
                "tags": [
                  "Clásico"
                ]
              },
              {
                "id": "limine",
                "name": "Limine",
                "pkg": "limine",
                "tags": [
                  "Actual",
                  "Moderno"
                ],
                "description": "Reemplaza efibootmgr, BIOS/UEFI 2024-2026"
              }
            ]
          }
        ]
      },
      {
        "id": "environment",
        "name": "Entorno Gráfico",
        "icon": "🖥️",
        "mode": "single",
        "single_compositor": true,
        "sections": [
          {
            "id": "compositor",
            "name": "Compositor / DE - Selección Única",
            "single": true,
            "options": [
              {
                "id": "hyprland",
                "name": "Hyprland",
                "pkg": "hyprland"
              },
              {
                "id": "gnome",
                "name": "GNOME",
                "pkg": "gnome",
                "auto_dm": "gdm"
              },
              {
                "id": "sway",
                "name": "Sway",
                "pkg": "sway"
              },
              {
                "id": "cosmic",
                "name": "COSMIC",
                "pkg": "cosmic-epoch",
                "note": "Reemplaza KDE Plasma"
              }
            ]
          },
          {
            "id": "dm",
            "name": "Display Manager",
            "single": true,
            "auto_logic": "GNOME -> GDM bloqueado",
            "options": [
              {
                "id": "gdm",
                "name": "GDM",
                "pkg": "gdm"
              },
              {
                "id": "sddm",
                "name": "SDDM",
                "pkg": "sddm"
              },
              {
                "id": "greetd-tuigreet",
                "name": "greetd + tuigreet",
