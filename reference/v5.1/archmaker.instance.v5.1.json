      {
        "id": "apps",
        "name": "Aplicaciones",
        "icon": "📦",
        "sections": [
          {
            "id": "terminal",
            "name": "Terminal",
            "options": [
              {
                "id": "ghostty",
                "name": "Ghostty",
                "pkg": "ghostty",
                "tags": [
                  "Moderno"
                ],
                "description": "Zig, GPU, reemplaza Alacritty"
              },
              {
                "id": "kitty",
                "name": "Kitty",
                "pkg": "kitty",
                "tags": [
                  "Recomendado"
                ],
                "description": "GPU, ligatures"
              },
              {
                "id": "foot",
                "name": "Foot",
                "pkg": "foot",
                "tags": [
                  "Ligero"
                ]
              }
            ]
          },
          {
            "id": "browser",
            "name": "Navegación",
            "options": [
              {
                "id": "firefox",
                "name": "Firefox",
                "pkg": "firefox"
              },
              {
                "id": "vivaldi",
                "name": "Vivaldi",
                "pkg": "vivaldi"
              },
              {
                "id": "brave-bin",
                "name": "Brave",
