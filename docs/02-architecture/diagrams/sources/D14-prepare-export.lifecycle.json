{
  "schema_version": 3,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "D14 Preparación/exportación e invalidación",
    "output": "rendered/D14.html",
    "quality_profile": "showcase",
    "animation": "trace"
  },
  "mainPath": [
    "idle",
    "resolving",
    "prepared",
    "exporting"
  ],
  "states": [
    {
      "id": "idle",
      "type": "start",
      "label": "Idle",
      "step": "01"
    },
    {
      "id": "resolving",
      "type": "active",
      "label": "Resolving",
      "step": "02"
    },
    {
      "id": "prepared",
      "type": "success",
      "label": "Prepared",
      "step": "03"
    },
    {
      "id": "exporting",
      "type": "active",
      "label": "Exporting",
      "step": "04"
    },
    {
      "id": "stale",
      "type": "failure",
      "label": "Stale",
      "tag": "invalidate"
    }
  ],
  "transitions": [
    {
      "id": "i-r",
      "from": "idle",
      "to": "resolving",
      "label": "prepare"
    },
    {
      "id": "r-p",
      "from": "resolving",
      "to": "prepared",
      "label": "ok"
    },
    {
      "id": "p-e",
      "from": "prepared",
      "to": "exporting",
      "label": "export"
    },
    {
      "id": "e-i",
      "from": "exporting",
      "to": "idle",
      "label": "done"
    },
    {
      "id": "p-s",
      "from": "prepared",
      "to": "stale",
      "label": "draft changed",
      "variant": "security"
    },
    {
      "id": "s-r",
      "from": "stale",
      "to": "resolving",
      "label": "re-prepare"
    }
  ],
  "cards": [
    {
      "dot": "amber",
      "title": "Invalidación",
      "items": [
        "isPreparedCurrent en App.tsx",
        "No reutilizar manifiesto obsoleto"
      ]
    }
  ]
}
