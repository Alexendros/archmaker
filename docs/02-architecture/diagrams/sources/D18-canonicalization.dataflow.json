{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "D18 Canonicalización y digests",
    "output": "rendered/D18.html",
    "quality_profile": "showcase",
    "animation": "trace",
    "viewBox": [
      1100,
      720
    ]
  },
  "stages": [
    {
      "label": "Draft"
    },
    {
      "label": "Canon"
    },
    {
      "label": "Resolve"
    },
    {
      "label": "Artifact"
    }
  ],
  "nodes": [
    {
      "id": "draft",
      "type": "frontend",
      "label": "Draft JSON",
      "stage": 0,
      "row": 2
    },
    {
      "id": "canon",
      "type": "backend",
      "label": "canonicalization",
      "stage": 1,
      "row": 2,
      "tag": "contentDigest"
    },
    {
      "id": "res",
      "type": "backend",
      "label": "resolution",
      "stage": 2,
      "row": 1,
      "tag": "resolutionDigest"
    },
    {
      "id": "man",
      "type": "backend",
      "label": "Manifest",
      "stage": 2,
      "row": 3
    },
    {
      "id": "bin",
      "type": "cloud",
      "label": "Rendered bytes",
      "stage": 3,
      "row": 2,
      "tag": "binaryDigest"
    }
  ],
  "flows": [
    {
      "from": "draft",
      "to": "canon",
      "label": "canonicalize",
      "variant": "emphasis",
      "route": "straight"
    },
    {
      "from": "canon",
      "to": "res",
      "label": "resolve",
      "route": "vertical-channel"
    },
    {
      "from": "canon",
      "to": "man",
      "label": "seal",
      "route": "vertical-channel"
    },
    {
      "from": "man",
      "to": "bin",
      "label": "render",
      "variant": "emphasis",
      "route": "straight"
    }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "Separar digests",
      "items": [
        "contentDigest: contenido canónico",
        "resolutionDigest: resultado de resolución",
        "binaryDigest: bytes entregados"
      ]
    }
  ]
}
