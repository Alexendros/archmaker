{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archmaker.dev/schemas/manifest.schema.json",
  "title": "ArchMaker Manifest (DM-MANIFEST, v0)",
  "description": "Canonical, closed, ordered and hashed materialization of a Resolution without blockers. Input of exporters and of the v1 plan. The contentDigest follows the canonicalization profile v1 (ADR-0007): SHA-256 over the canonical payload prefixed by the domain label archmaker:manifest:v1. Contract state: v0.",
  "$comment": "Contract v0 (phase R6, AUD-015, supported by the AUD-010 canonicalization vectors). contentDigest replaces manifestDigest; unknown fields rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "documentVersion",
    "schemaVersion",
    "domainLabel",
    "catalogRef",
    "targetRef",
    "producer",
    "resolutionDigest",
    "effectiveSelections",
    "providedCapabilities",
    "requiredCapabilities",
    "conflicts",
    "contentDigest"
  ],
  "properties": {
    "documentVersion": {
      "$ref": "https://archmaker.dev/schemas/common.schema.json#/$defs/documentVersion"
    },
    "schemaVersion": {
      "description": "Manifest contract axis. Only \"1\" and \"2\" are accepted (ADR-0016).",
      "type": "string",
      "enum": ["1", "2"]
    },
    "domainLabel": {
      "description": "Domain separation label used for the canonical hash (ADR-0007 / ADR-0016).",
      "type": "string",
      "enum": ["archmaker:manifest:v1", "archmaker:manifest:v2"]
    },
    "catalogRef": {
      "description": "Exact catalog version consumed.",
      "$ref": "https://archmaker.dev/schemas/common.schema.json#/$defs/catalogRef"
    },
    "targetRef": {
      "description": "Export target the manifest is materialized for.",
      "$ref": "https://archmaker.dev/schemas/common.schema.json#/$defs/targetRef"
    },
    "producer": {
      "description": "Producer identity and version (axis producer.version).",
      "$ref": "https://archmaker.dev/schemas/common.schema.json#/$defs/producer"
    },
    "resolutionDigest": {
      "description": "Semantic content digest of the Resolution that fed the manifest; traceability back to the ephemeral resolution.",
      "$ref": "https://archmaker.dev/schemas/common.schema.json#/$defs/contentDigest"
    },
    "effectiveSelections": {
      "description": "Frozen effective selections: manual plus derived, ordered by step ID.",
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "https://archmaker.dev/schemas/common.schema.json#/$defs/resolvedSelection"
      }
    },
    "providedCapabilities": {
      "description": "Computed closure of provided capabilities.",
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "https://archmaker.dev/schemas/common.schema.json#/$defs/capabilityRef"
      }
    },
    "requiredCapabilities": {
      "description": "Capabilities required by the effective selections.",
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "https://archmaker.dev/schemas/common.schema.json#/$defs/capabilityRef"
      }
    },
    "conflicts": {
      "description": "Remaining conflicts; empty for a sealed manifest.",
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "https://archmaker.dev/schemas/common.schema.json#/$defs/conflict"
      }
    },
    "contentDigest": {
      "description": "Canonical semantic digest of this manifest payload (ADR-0007). Domain tag follows domainLabel (v1 or v2).",
      "$ref": "https://archmaker.dev/schemas/common.schema.json#/$defs/contentDigest"
    },
    "storagePlan": {
      "$ref": "https://archmaker.dev/schemas/draft-v2-defs.schema.json#/$defs/storagePlan"
    },
    "encryptionPolicy": {
      "$ref": "https://archmaker.dev/schemas/draft-v2-defs.schema.json#/$defs/encryptionPolicy"
    },
    "browserPolicy": {
      "$ref": "https://archmaker.dev/schemas/draft-v2-defs.schema.json#/$defs/browserPolicy"
    },
    "verification": {
      "$ref": "https://archmaker.dev/schemas/draft-v2-defs.schema.json#/$defs/verificationStatuses"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schemaVersion": { "const": "1" } },
        "required": ["schemaVersion"]
      },
      "then": {
        "properties": { "domainLabel": { "const": "archmaker:manifest:v1" } },
        "not": {
          "anyOf": [
            { "required": ["storagePlan"] },
            { "required": ["encryptionPolicy"] },
            { "required": ["browserPolicy"] },
            { "required": ["verification"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "schemaVersion": { "const": "2" } },
        "required": ["schemaVersion"]
      },
      "then": {
        "properties": { "domainLabel": { "const": "archmaker:manifest:v2" } }
      }
    }
  ]
}
