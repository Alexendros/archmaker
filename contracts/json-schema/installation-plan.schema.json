{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archmaker.dev/schemas/installation-plan.schema.json",
  "title": "ArchMaker InstallationPlan (DM-PLAN, v1)",
  "description": "Immutable ordered sequence of typed allowlisted operations derived from a sealed manifest. Never a script and never contains shell (ADR-0004). planHash and manifestHash are semantic content digests (ADR-0007). Contract state: v0.",
  "$comment": "Contract v0 (phase R6). Shared $defs live in common.schema.json; planHash/manifestHash are content digests. Unknown fields rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "documentVersion",
    "schemaVersion",
    "planId",
    "planHash",
    "manifestHash",
    "catalogRef",
    "targetRef",
    "producer",
    "operations"
  ],
  "properties": {
    "documentVersion": {
      "$ref": "https://archmaker.dev/schemas/common.schema.json#/$defs/documentVersion"
    },
    "schemaVersion": {
      "$ref": "https://archmaker.dev/schemas/common.schema.json#/$defs/schemaVersion"
    },
    "protocolVersion": {
      "description": "Negotiated runner protocol version (axis protocolVersion).",
      "$ref": "https://archmaker.dev/schemas/common.schema.json#/$defs/protocolVersion"
    },
    "planId": {
      "description": "Plan identity (UUID).",
      "$ref": "https://archmaker.dev/schemas/common.schema.json#/$defs/uuid"
    },
    "planHash": {
      "description": "Semantic content digest of the plan payload; bound to confirmation together with manifestHash (ADR-0004).",
      "$ref": "https://archmaker.dev/schemas/common.schema.json#/$defs/contentDigest"
    },
    "manifestHash": {
      "description": "Semantic content digest of the sealed manifest the plan derives from.",
      "$ref": "https://archmaker.dev/schemas/common.schema.json#/$defs/contentDigest"
    },
    "catalogRef": {
      "description": "Exact catalog version consumed.",
      "$ref": "https://archmaker.dev/schemas/common.schema.json#/$defs/catalogRef"
    },
    "targetRef": {
      "description": "Target the plan is derived for.",
      "$ref": "https://archmaker.dev/schemas/common.schema.json#/$defs/targetRef"
    },
    "producer": {
      "description": "Producer identity and version (axis producer.version).",
      "$ref": "https://archmaker.dev/schemas/common.schema.json#/$defs/producer"
    },
    "operations": {
      "description": "Ordered allowlisted operations. Order is semantic and preserved; the plan is immutable.",
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/operation"
      }
    }
  },
  "$defs": {
    "operation": {
      "description": "A typed, allowlisted plan operation. Parameters are a closed set of declarative values; no command or script is representable.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "kind"
      ],
      "properties": {
        "order": {
          "description": "Zero-based position of the operation in the plan.",
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "description": "Allowlisted operation kind.",
          "enum": [
            "preflight.check",
            "disk.partition",
            "filesystem.create",
            "filesystem.mount",
            "package.install",
            "bootloader.install",
            "user.create",
            "locale.configure",
            "service.enable",
            "snapshot.create",
            "verification.checksum"
          ]
        },
        "description": {
          "type": "string",
          "maxLength": 1024
        },
        "preconditions": {
          "description": "Capabilities that must hold before executing the operation.",
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "https://archmaker.dev/schemas/common.schema.json#/$defs/capabilityId"
          }
        },
        "parameters": {
          "description": "Declarative operation parameters. Closed set; every value is data, never a command.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "deviceRef": {
              "description": "Opaque handle to a block device resolved by preflight.",
              "type": "string",
              "maxLength": 256
            },
            "mountPoint": {
              "description": "Absolute mount point path.",
              "type": "string",
              "pattern": "^/",
              "maxLength": 4096
            },
            "filesystem": {
              "$ref": "https://archmaker.dev/schemas/common.schema.json#/$defs/capabilityId"
            },
            "packageIds": {
              "description": "Package entity identifiers to install.",
              "type": "array",
              "maxItems": 4096,
              "items": {
                "$ref": "https://archmaker.dev/schemas/common.schema.json#/$defs/entityId"
              }
            },
            "packageGroupIds": {
              "description": "Package group entity identifiers to install.",
              "type": "array",
              "maxItems": 4096,
              "items": {
                "$ref": "https://archmaker.dev/schemas/common.schema.json#/$defs/entityId"
              }
            },
            "userRef": {
              "description": "Opaque reference to a user definition.",
              "type": "string",
              "maxLength": 256
            },
            "locale": {
              "type": "string",
              "maxLength": 64
            },
            "keymap": {
              "type": "string",
              "maxLength": 64
            },
            "timezone": {
              "type": "string",
              "maxLength": 128
            },
            "serviceUnit": {
              "type": "string",
              "maxLength": 256
            },
            "checksum": {
              "description": "Binary digest of the bytes being verified.",
              "$ref": "https://archmaker.dev/schemas/common.schema.json#/$defs/binaryDigest"
            }
          }
        }
      }
    }
  }
}
