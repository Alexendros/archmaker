{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archmaker.dev/schemas/catalog.schema.json",
  "title": "ArchMaker Catalog (DM-CATALOG, v0)",
  "description": "Versioned, immutable set of definitions (steps, options, libpacks, capabilities, rule references) plus provenance metadata. Declares what can be chosen and with which consequences; never contains commands, hooks or shell. Contract state: v0.",
  "$comment": "Contract v0 (phase R6, AUD-013). Shared $defs live in common.schema.json. Unknown fields rejected except the documented open metadata map.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "namespace",
    "id",
    "version",
    "documentVersion",
    "schemaVersion",
    "steps"
  ],
  "properties": {
    "namespace": {
      "description": "Global namespace with the DEC-002 vendor.kind shape.",
      "$ref": "https://archmaker.dev/schemas/common.schema.json#/$defs/namespace"
    },
    "id": {
      "description": "Catalog identifier within the namespace.",
      "$ref": "https://archmaker.dev/schemas/common.schema.json#/$defs/shortId"
    },
    "version": {
      "description": "Catalog version (axis catalogRef.version).",
      "$ref": "https://archmaker.dev/schemas/common.schema.json#/$defs/semver"
    },
    "revision": {
      "description": "Monotonic revision of the catalog document, when the store tracks successive publications. Optional.",
      "$ref": "https://archmaker.dev/schemas/common.schema.json#/$defs/revision"
    },
    "documentVersion": {
      "$ref": "https://archmaker.dev/schemas/common.schema.json#/$defs/documentVersion"
    },
    "schemaVersion": {
      "$ref": "https://archmaker.dev/schemas/common.schema.json#/$defs/schemaVersion"
    },
    "contentDigest": {
      "description": "Semantic content digest of the catalog payload (ADR-0007), computed externally. Never comparable with a binary digest.",
      "$ref": "https://archmaker.dev/schemas/common.schema.json#/$defs/contentDigest"
    },
    "metadata": {
      "description": "Open catalog metadata map (free-form string values, e.g. owner, locale). Documented open map required by the domain; keys are not fixed by this contract.",
      "type": "object",
      "maxProperties": 128,
      "additionalProperties": {
        "type": "string",
        "maxLength": 1024
      }
    },
    "steps": {
      "description": "Ordered catalog steps.",
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "libpacks": {
      "description": "Library packs grouping essential and recommended options.",
      "type": "array",
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/libpack"
      }
    },
    "capabilities": {
      "description": "Technical capabilities referenced by options and rules.",
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "rules": {
      "description": "References to rule definitions that constrain this catalog.",
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/ruleRef"
      }
    }
  },
  "$defs": {
    "step": {
      "description": "A catalog step: a decision point with one or more sections.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "mode",
        "sections"
      ],
      "properties": {
        "id": {
          "$ref": "https://archmaker.dev/schemas/common.schema.json#/$defs/entityId"
        },
        "title": {
          "description": "Human-readable step title.",
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "description": {
          "description": "Optional step explanation.",
          "type": "string",
          "maxLength": 4096
        },
        "mode": {
          "description": "Presentation mode of the step (grouped, flat or single).",
          "enum": [
            "grouped",
            "flat",
            "single"
          ]
        },
        "sections": {
          "description": "Sections contained in the step.",
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/section"
          }
        }
      }
    },
    "section": {
      "description": "A group of mutually related options within a step.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "cardinality",
        "options"
      ],
      "properties": {
        "id": {
          "$ref": "https://archmaker.dev/schemas/common.schema.json#/$defs/entityId"
        },
        "title": {
          "description": "Human-readable section title.",
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "maxLength": 4096
        },
        "cardinality": {
          "description": "Maximum number of selectable options: one or many.",
          "enum": [
            "one",
            "many"
          ]
        },
        "options": {
          "description": "Selectable options in the section.",
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/option"
          }
        }
      }
    },
    "option": {
      "description": "A selectable option with intent and metadata only. No installable facts (packages or versions) are declared here.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "https://archmaker.dev/schemas/common.schema.json#/$defs/entityId"
        },
        "title": {
          "description": "Human-readable option title.",
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "maxLength": 4096
        },
        "fixed": {
          "description": "Whether the option is essential and cannot be deselected.",
          "type": "boolean"
        },
        "essentialReason": {
          "description": "Reason why the option is essential.",
          "type": "string",
          "maxLength": 1024
        },
        "tags": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 128
          }
        },
        "provides": {
          "description": "Capabilities this option provides.",
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "https://archmaker.dev/schemas/common.schema.json#/$defs/capabilityId"
          }
        },
        "requires": {
          "description": "Capabilities this option requires.",
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "https://archmaker.dev/schemas/common.schema.json#/$defs/capabilityId"
          }
        }
      }
    },
    "libpack": {
      "description": "A named pack of essential and recommended options.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "essential",
        "recommended"
      ],
      "properties": {
        "id": {
          "$ref": "https://archmaker.dev/schemas/common.schema.json#/$defs/entityId"
        },
        "title": {
          "description": "Human-readable pack title.",
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "maxLength": 4096
        },
        "essential": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "recommended": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/option"
          }
        }
      }
    },
    "capability": {
      "description": "A technical capability declaration.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "https://archmaker.dev/schemas/common.schema.json#/$defs/capabilityId"
        },
        "title": {
          "type": "string",
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "maxLength": 4096
        }
      }
    },
    "ruleRef": {
      "description": "Reference to a rule definition that constrains selections.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "description": "Rule identifier.",
          "type": "string",
          "pattern": "^RULE-[A-Z0-9]+(-[A-Z0-9]+)+$"
        },
        "digest": {
          "$ref": "https://archmaker.dev/schemas/common.schema.json#/$defs/contentDigest"
        }
      }
    }
  }
}
